# Rendered by Terraform (storage.tf) from templates/env.tftpl — do not edit
# the SSM parameter directly for values sourced from AWS; edit variables.tf
# defaults or terraform.tfvars instead, and re-apply.

DEBUG=False
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://${alb_dns_name}
CORS_ALLOW_CREDENTIALS=True

DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
DATABASE_NAME=${rds_db}
DATABASE_USER=${rds_master_username}
DATABASE_PASSWORD=${rds_master_password}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

RDS_HOST=${rds_host}
RDS_DB=${rds_db}
RDS_USER=${rds_master_username}
RDS_PASSWORD=${rds_master_password}

REDIS_HOST=${redis_host}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=${redis_auth_token}
REDIS_SSL=True
REDIS_CACHE_TTL=86400

BASE_URL=http://${alb_dns_name}
FRONTEND_BASE_URL=http://${alb_dns_name}
API_BASE_URL=http://${alb_dns_name}

SHORT_CODE_LENGTH=6
CUSTOM_ALIAS_MAX_LENGTH=50
ENABLE_QR_CODE=True
ENABLE_ANALYTICS=True
ENABLE_CUSTOM_ALIAS=True
ENABLE_RATE_LIMITING=False

LOG_LEVEL=INFO

MONITORING_PRIVATE_IP=${monitoring_private_ip}
ECR_REGISTRY=${ecr_registry}
IMAGE_TAG=${image_tag}

GRAFANA_ADMIN_USER=${grafana_admin_user}
GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}
GRAFANA_PROXY_USER=${grafana_proxy_user}
GRAFANA_PROXY_PASSWORD=${grafana_proxy_password}
