# ── Container images (AWS deployment only, not used by local docker-compose.yml) ──
ECR_REGISTRY=<account-id>.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

# ── Backend: Server ──────────────────────────────
APP_NAME=URL Shortener
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ── Backend: CORS ────────────────────────────────
# Comma-separated. Must include wherever the frontend is actually served from.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://<EC2_PUBLIC_IP>

# ── Backend: Database (via PgBouncer → RDS) ──────
# DATABASE_USER/PASSWORD/NAME must exactly match RDS_USER/RDS_PASSWORD/RDS_DB
# below — PgBouncer's userlist only contains RDS's credentials, so the
# backend authenticates to PgBouncer using RDS's actual credentials.
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
DATABASE_NAME=urlshortener
DATABASE_USER=<rds-master-username>
DATABASE_PASSWORD=<rds-master-password>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── RDS connection details (used by pgbouncer + postgres_exporter) ──
RDS_HOST=<rds-endpoint>.rds.amazonaws.com
RDS_DB=urlshortener
RDS_USER=<rds-master-username>
RDS_PASSWORD=<rds-master-password>

# ── Backend: Redis (ElastiCache) ───────────────────────────────
REDIS_HOST=<elasticache-primary-endpoint>.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<elasticache-auth-token>
REDIS_SSL=True
REDIS_CACHE_TTL=86400

# ── Backend: URL Config ──────────────────────────
BASE_URL=http://<EC2_PUBLIC_IP>
SHORT_CODE_LENGTH=6
CUSTOM_ALIAS_MAX_LENGTH=50

# ── Backend: Feature Flags ───────────────────────
ENABLE_QR_CODE=True
ENABLE_ANALYTICS=True
ENABLE_CUSTOM_ALIAS=True
ENABLE_RATE_LIMITING=False

# ── Backend: Rate Limiting ───────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Backend: Logging ──────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (consumed by entrypoint.sh at container start) ──
FRONTEND_BASE_URL=http://<EC2_PUBLIC_IP>
API_BASE_URL=http://<EC2_PUBLIC_IP>
ENABLE_QR_CODE=True

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

MONITORING_PRIVATE_IP=<set-after-launching-the-monitoring-instance>